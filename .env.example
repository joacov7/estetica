# ---------------------------------------------------------------------------
# Database — Postgres (Neon). Use the POOLED connection string for serverless.
# Get it from the Neon dashboard → Connection Details.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth)
# ---------------------------------------------------------------------------
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# In production set to your deployed URL; not needed for localhost.
# AUTH_URL="https://your-app.vercel.app"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign booking-management tokens (cancel/reschedule links).
# Generate with: openssl rand -base64 32
BOOKING_TOKEN_SECRET="change-me-in-production"

# ---------------------------------------------------------------------------
# Rate limiting (optional) — Upstash Redis. If unset, falls back to an
# in-memory limiter (per instance). Create a free DB at upstash.com.
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# ---------------------------------------------------------------------------
# Bot protection (optional) — Cloudflare Turnstile. If unset, the captcha is
# skipped. Get keys at dash.cloudflare.com → Turnstile.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-site-key"   # public (browser)
# TURNSTILE_SECRET_KEY="your-secret-key"           # server only
