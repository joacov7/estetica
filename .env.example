# ---------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ---------------------------------------------------------------------------
# Supabase — server only. NEVER expose these to the browser / client bundle.
# The service role key bypasses RLS; keep it strictly server-side.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL, used to build booking links and .ics / calendar URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign booking-management tokens (cancel/reschedule links).
# Generate with: openssl rand -base64 32
BOOKING_TOKEN_SECRET="change-me-in-production"
